{
  "name": "Pauta — vida pessoal e profissional",
  "short_name": "Pauta",
  "description": "Agenda, escala de serviços, trocas, finanças, prazos e rotinas em um só app.",
  "lang": "pt-BR",
  "start_url": "./#/inicio",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f4f6",
  "theme_color": "#1f6fd1",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Agenda", "url": "./#/agenda", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tarefas", "url": "./#/tarefas", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Escala", "url": "./#/escala", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Finanças", "url": "./#/financas", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
